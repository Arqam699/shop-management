# ============================================================
# SERVER
# ============================================================
PORT=5000
NODE_ENV=development

# ============================================================
# DATABASE (MongoDB Atlas connection string)
# ============================================================
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# ============================================================
# AUTH
# Use a long random value (e.g. `openssl rand -hex 48`).
# NEVER commit the real secret.
# ============================================================
JWT_SECRET=replace_with_a_long_random_secret

# ============================================================
# SEEDED ADMIN (created only if the admin does not exist yet)
# There is intentionally NO hardcoded fallback password.
# ============================================================
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=set_a_strong_password

# ============================================================
# SEEDED SUPER ADMIN
# ============================================================
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_EMAIL=superadmin@shop.com
SUPER_ADMIN_PASSWORD=set_a_strong_password

# ============================================================
# CORS / FRONTEND
# Comma-separated list of exact, trusted frontend origins (for example,
# https://your-shop-app.vercel.app). In production, use HTTPS and never
# add origins you do not control; these origins can make credentialed
# browser requests to the API.
# ============================================================
FRONTEND_URL=http://localhost:5173

# ============================================================
# AI ASSISTANT (Groq)
# ============================================================
GROQ_API_KEY=your_groq_key_here
AI_MODEL=openai/gpt-oss-120b
AI_DAILY_LIMIT=50
